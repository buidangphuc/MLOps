# STAGING environment — copy to `.env.staging` and fill, then:
#   set -a; source .env.staging; set +a   (or: docker run --env-file .env.staging ...)
# Real values live in .env.staging (gitignored). This .example is the committed template.

# --- model registry / serving (serve/local.py) ---
MODEL_SOURCE=registry
MODEL_VERSION=v1
S3_BUCKET=            # staging bucket (fill; runbook §1 staging bucket)
S3_PREFIX=registry
AWS_REGION=ap-southeast-1

# --- SageMaker deploy (deploy_sagemaker.py) — only needed for `deploy` ---
S3_MME_PREFIX=bds-genai-deploy/models/v-REPLACE
SAGEMAKER_EXECUTION_ROLE=      # role ARN (fill)
TRITON_IMAGE=                  # region SageMaker Triton DLC URI (fill)

# --- AWS credentials (STS temporary — fill; NEVER commit real values) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
